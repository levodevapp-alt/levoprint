<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scrollMain"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true" android:background="@color/navy">
  <LinearLayout
      android:layout_width="match_parent" android:layout_height="wrap_content"
      android:orientation="vertical" android:padding="20dp">

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="LevoPrint" android:textColor="@color/oro"
        android:textSize="26sp" android:textStyle="bold" />
    <!-- [MM4-08] Sin el rayo: la marca fase 3 dejó a los productos sin él. -->
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Gestor de impresoras · LevoDev" android:textColor="#8FB6D9"
        android:textSize="13sp" android:layout_marginBottom="18dp" />

    <!-- [MM4-08] Pantalla para el cajero: código, «Vincular» y «Escanear QR» al mismo peso
         y el estado. Acepta el código con guiones o puntos (K-ABCD-2345): maxLength con holgura. -->
    <TextView style="@style/Etiqueta" android:text="Código de vinculación (9 letras y números)" />
    <EditText android:id="@+id/inCodigo" style="@style/Campo"
        android:hint="KABCD2345" android:maxLength="13"
        android:inputType="textCapCharacters|textNoSuggestions" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:textColor="#8FB6D9" android:textSize="12sp"
        android:text="Lo ves en KOMO › Estaciones, KIPU › Impresoras o KUTI › Impresoras. Dura 15 min. ¿Usas varias apps? Vincula el código de cada una: este equipo imprime para todas." />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:layout_marginTop="8dp">
      <Button android:id="@+id/btnEmparejar" android:layout_width="0dp"
          android:layout_height="wrap_content" android:layout_weight="1"
          android:minHeight="48dp"
          android:layout_marginEnd="6dp" android:text="Vincular" android:textStyle="bold"
          android:backgroundTint="@color/cian" android:textColor="@color/navy" />
      <Button android:id="@+id/btnEscanear" android:layout_width="0dp"
          android:layout_height="wrap_content" android:layout_weight="1"
          android:minHeight="48dp"
          android:layout_marginStart="6dp" android:text="Escanear QR" android:textStyle="bold"
          android:backgroundTint="@color/oro" android:textColor="@color/navy" />
    </LinearLayout>

    <!-- [MM4-06] El color lo pone MainActivity: verde si salió bien, rojo si falló. -->
    <TextView android:id="@+id/txtEmparejar" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="8dp"
        android:textColor="#8FB6D9" android:textSize="13sp" android:textStyle="bold" />

    <!-- [LP-U1] Apps vinculadas en este equipo: un mismo LevoPrint imprime para KOMO, KIPU
         y KUTI. Para sumar otra app basta con escribir (o escanear) el código de esa app. -->
    <TextView android:id="@+id/txtVinculos" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="8dp"
        android:visibility="gone" android:textColor="#EAF4FF" android:textSize="13sp" />

    <!-- [LP-F3] Estaciones de las apps vinculadas con su impresora (red, Bluetooth o USB) y
         «Elegir» / «Cambiar». Las filas las arma MainActivity. -->
    <LinearLayout android:id="@+id/boxEstaciones" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="8dp"
        android:orientation="vertical" />

    <!-- [LP-F3] «¿Dónde está la impresora de <estación>?»: lo encontrado agrupado (red, Bluetooth,
         USB); tocar = papel de prueba → «¿Salió?» → Sí = queda guardada en la app. -->
    <LinearLayout android:id="@+id/cardDestino" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="12dp"
        android:orientation="vertical" android:padding="14dp" android:background="#14406C"
        android:visibility="gone">
      <TextView android:id="@+id/txtDestinoTitulo" android:layout_width="match_parent"
          android:layout_height="wrap_content" android:textColor="@color/oro" android:textSize="16sp"
          android:textStyle="bold" />
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
          android:layout_marginTop="4dp" android:textColor="#8FB6D9" android:textSize="12sp"
          android:text="Toca una: sale un papel de prueba. Si salió, esa es." />
      <LinearLayout android:id="@+id/boxEncontradas" android:layout_width="match_parent"
          android:layout_height="wrap_content" android:orientation="vertical" />
      <TextView android:id="@+id/txtDestinoMsg" android:layout_width="match_parent"
          android:layout_height="wrap_content" android:layout_marginTop="8dp"
          android:textColor="#8FB6D9" android:textSize="13sp" android:textStyle="bold" />
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
          android:orientation="horizontal" android:layout_marginTop="8dp">
        <Button android:id="@+id/btnBuscarImpresoras" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1" android:minHeight="48dp"
            android:layout_marginEnd="4dp" android:text="Buscar de nuevo"
            android:backgroundTint="@color/cian" android:textColor="@color/navy" />
        <Button android:id="@+id/btnNoLaVeo" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1" android:minHeight="48dp"
            android:layout_marginStart="4dp" android:layout_marginEnd="4dp" android:text="No la veo"
            android:backgroundTint="@color/navy" android:textColor="#EAF4FF" />
        <Button android:id="@+id/btnCerrarDestino" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1" android:minHeight="48dp"
            android:layout_marginStart="4dp" android:text="Cerrar"
            android:backgroundTint="@color/navy" android:textColor="#EAF4FF" />
      </LinearLayout>
      <LinearLayout android:id="@+id/boxNoLaVeo" android:layout_width="match_parent"
          android:layout_height="wrap_content" android:orientation="vertical"
          android:layout_marginTop="8dp" android:visibility="gone">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="#EAF4FF" android:textSize="13sp"
            android:text="Revisa que la impresora esté encendida. De red: conectada al mismo router o Wi-Fi que este equipo. Bluetooth: encendida y cerca (si pide un PIN, prueba 0000 o 1234). USB: con su cable conectado a este equipo. Luego toca «Buscar de nuevo»." />
        <TextView style="@style/Etiqueta" android:text="¿Sabes su IP? (sale en el papel de autoprueba de la impresora)" />
        <EditText android:id="@+id/inIpManual" style="@style/Campo"
            android:hint="192.168.1.50" android:inputType="textUri" />
        <Button android:id="@+id/btnProbarIp" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="48dp" android:text="Probar esta IP"
            android:backgroundTint="@color/oro" android:textColor="@color/navy" />
      </LinearLayout>
    </LinearLayout>

    <!-- [MM4-07] Ahorro de batería: se muestra con el equipo vinculado mientras Android
         pueda dormir a LevoPrint; al volver de Ajustes con el permiso, queda en verde. -->
    <LinearLayout android:id="@+id/cardBateria" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="12dp"
        android:orientation="vertical" android:padding="14dp" android:background="#14406C"
        android:visibility="gone">
      <TextView android:id="@+id/txtBateria" android:layout_width="match_parent"
          android:layout_height="wrap_content" android:textColor="#EAF4FF" android:textSize="14sp"
          android:text="Para que las comandas salgan siempre, deja a LevoPrint sin ahorro de batería. Si no, el celular lo duerme a los minutos de apagar la pantalla." />
      <Button android:id="@+id/btnBateria" android:layout_width="match_parent"
          android:layout_height="wrap_content" android:layout_marginTop="8dp"
          android:minHeight="48dp" android:text="Permitir" android:textStyle="bold"
          android:backgroundTint="@color/oro" android:textColor="@color/navy" />
    </LinearLayout>

    <View android:layout_width="match_parent" android:layout_height="1dp"
        android:background="#14406C" android:layout_marginTop="18dp" android:layout_marginBottom="6dp" />
    <!-- [MM4-08] La configuración manual va plegada (cerrada por defecto): si alguien toca
         algo ahí rompe la vinculación, y para el cajero solo asusta. -->
    <TextView android:id="@+id/btnAvanzadas" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:minHeight="48dp" android:gravity="center_vertical"
        android:text="▸ Opciones avanzadas" android:textColor="#8FB6D9" android:textSize="14sp"
        android:textStyle="bold" android:clickable="true" android:focusable="true"
        android:background="?android:attr/selectableItemBackground" />

    <LinearLayout android:id="@+id/boxAvanzadas" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:orientation="vertical"
        android:visibility="gone">
    <TextView style="@style/Etiqueta" android:text="URL del backend" />
    <EditText android:id="@+id/inUrl" style="@style/Campo"
        android:hint="https://xxxx.supabase.co" android:inputType="textUri" />

    <TextView style="@style/Etiqueta" android:text="Clave anónima (anon key)" />
    <EditText android:id="@+id/inAnon" style="@style/Campo"
        android:hint="eyJ..." android:inputType="textNoSuggestions" />

    <TextView style="@style/Etiqueta" android:text="Device (te lo da LevoDev)" />
    <EditText android:id="@+id/inDevice" style="@style/Campo"
        android:hint="uuid del dispositivo" android:inputType="textNoSuggestions" />

    <TextView style="@style/Etiqueta" android:text="App (prefijo)" />
    <EditText android:id="@+id/inPrefijo" style="@style/Campo"
        android:hint="komo" android:text="komo" android:inputType="text" />

    <TextView style="@style/Etiqueta" android:text="Ancho del papel (columnas: 48=80mm, 32=58mm)" />
    <EditText android:id="@+id/inAncho" style="@style/Campo"
        android:hint="48" android:text="48" android:inputType="number" />

    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/swImagen"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:checked="true"
        android:text="Pie con logo (apagalo si tu impresora no imprime imagenes)" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:layout_marginTop="12dp">
      <com.google.android.material.materialswitch.MaterialSwitch
          android:id="@+id/swBluetooth"
          android:layout_width="wrap_content" android:layout_height="wrap_content" />
      <TextView android:layout_width="0dp" android:layout_height="wrap_content"
          android:layout_weight="1" android:layout_marginStart="10dp"
          android:text="Habilitar impresora Bluetooth (opcional)"
          android:textColor="#EAF4FF" android:textSize="14sp" />
    </LinearLayout>

    <Button android:id="@+id/btnBt" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="8dp"
        android:visibility="gone" android:text="Elegir impresora Bluetooth"
        android:backgroundTint="#14406C" android:textColor="#EAF4FF" />
    <TextView android:id="@+id/txtBt" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="4dp"
        android:visibility="gone" android:textColor="#8FB6D9" android:textSize="12sp" />

    <Button android:id="@+id/btnToggle" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="20dp"
        android:text="Guardar y arrancar" android:textStyle="bold"
        android:backgroundTint="@color/cian" android:textColor="@color/navy" />

    <TextView android:id="@+id/txtEstado" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="16dp"
        android:text="Detenido" android:textColor="@color/cian" android:textSize="14sp"
        android:textStyle="bold" />

    <TextView android:id="@+id/txtLog" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="10dp"
        android:fontFamily="monospace" android:textColor="#8FB6D9" android:textSize="11sp" />
  </LinearLayout>
</ScrollView>
